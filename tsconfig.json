{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./frontend/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": ["frontend", "vite.config.js"]
}
